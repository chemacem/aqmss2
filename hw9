#2 Part 2: Take-Home

lung <- survival::lung
lung$dead <- lung$status - 1

#2.1 Kaplan-Meier 

#a)
nrow(lung)
sum(lung$dead == 1, na.rm = TRUE)
sum(lung$dead == 0, na.rm = TRUE)
sum(lung$dead == 0, na.rm = TRUE) / sum(lung$dead == 1, na.rm = TRUE)

#The total observations is 228 and the number of deaths is 165.
#The number of censored cases is 63, which is a about 38% of all, also looks like a relatively big part.

#b)
survfit(Surv(time, dead) ~ 1, data = lung)

km_fit <- survfit(Surv(time, dead) ~ 1, data = lung)
summary(km_fit)

#310 days is the projected median survival time.
#This indicates that 50% of the patients passed away within 310 days after enrollment, while the remaining 50% lived longer.

#c)
km_sex <- survfit(Surv(time, dead) ~ sex, data = lung)

km_df <- tidy(km_sex)

km_df$sex <- factor(km_df$strata,
                    labels = c("Male", "Female"))

p <- ggplot(km_df, aes(x = time, y = estimate, color = "brown", fill = sex)) +
  geom_step(size = 1) +
  geom_ribbon(aes(ymin = conf.low, ymax = conf.high), alpha = 0.2, color = "purple") +
  labs(
    title = "Kaplan-Meier Survival Curves by Sex",
    x = "Time (days)",
    y = "Survival Probability",
    color = "Sex",
    fill = "Sex"
  ) +
  theme_minimal()

print(p)

ggsave("kmsurvivalbysex.pdf", plot = p, width = 8, height = 6)

#The Kaplan-Maier curve colorly demonstrates that women are more likely to survive at any given moment and, as a result, live longer. 
#Although the trend seems to be consistent, the confidence intervals do occasionally overlap.

survdiff(Surv(time, dead) ~ sex, data = lung)

#p=0.001 is the log-rank p-value.
#The log-rank test assesses whether survival distributions vary over time between groups. 
#A modest p-value indicates a substantial difference between the survival histories of males and females.

#2.2 Cox model

#a)
cox_model <- coxph(Surv(time, dead) ~ age + sex + ph.ecog, data = lung)

summary(cox_model)

#The sex hazard ratio is 0.575. This indicates that the risk of mortality is approximately 42.5% lower for women than for men. 
#The outcomes exhibit statistical significance. 

#b)
#Ph.ecog has a hazard ratio of 1.59. This indicates that the risk of dying increases by 59% for every unit rise in the ECOG performance level.

#c)
ph_test <- cox.zph(cox_model)

ph_test

#There is no evidence to refute the proportional hazards assumption, given all p-values are greater than 0.05. 
#As a result, the impacts of sex, age, and ph.ecog are probably consistent across time.

#d)
#1 Male survival is significantly greater than female survival, according to the Kaplan-Meier analysis.
#2Age is not a significant factor in the Cox model. Females are more likely to survive since the predictor sex is substantial and has a negative influence. 
#Ph.ecog is likewise significant and has a positive impact, meaning that the hazard ratio rises in tandem with each increase in the ECOG performance score. 
#3 The ph_test, which shows that no predictor has a p value less than 0.05, demonstrates that the proportional hazard assumption is true.
#4 A person's sex has a major impact on their likelihood of surviving at a particular period. Males have a reduced chance of surviving.
#The hazard ratio is also influenced by an individual's ECOG performance score.
